{
  "name": "budget-tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "check": "npm run typecheck && npm run lint && npm run boundaries && npm test",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "test": "npm test --workspaces --if-present",
    "eval": "npm run eval -w server",
    "db:reset": "npm run db:reset -w server"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
