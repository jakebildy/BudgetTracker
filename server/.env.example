# Required for Ask AI.
# Get a key at https://platform.claude.com. The rest of the app works without it.
ANTHROPIC_API_KEY=

# Optional. Model for the Ask AI agent loop.
AGENT_MODEL=claude-haiku-5-5

# Optional. Model for the scope check that runs alongside Ask AI.
FAST_MODEL=claude-haiku-5-5

# Optional. API port (the client proxies /api here).
PORT=3001

# Optional. Where transactions are stored, relative to server/.
DATA_FILE=data/db.json
