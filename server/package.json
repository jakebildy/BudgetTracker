{
  "name": "@budget/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=.env evals/runEvals.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/scripts/resetDatabase.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@budget/shared": "*",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
